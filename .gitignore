Cargo.lock

# pytest
.pytest_cache/

# CI-run scratch output (regenerated fresh by every workflow run via `tee`
# — never a committed deliverable; the real committed snapshots are the
# threat-model/*report*.json, *.md, and dashboard.html files checked in on
# purpose for docs/snapshot tests)
agent/*-report.txt
agent/eval/*-report.txt
agent/attack-sim-*.txt
agent/dashboard-summary.txt
agent/k8s-report.txt
agent/drift-report.txt
agent/detect-report.txt
demo/walkthrough.txt
logging/ingest.txt
logging/query.txt
